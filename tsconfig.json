{
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        "lib": ["ES2022"],
        "types": ["node"],
        "noEmit": true
    },
    "include": [
        "src/main",
        "src/shared",
        "spec/main",
        "spec/shared",
        "spec/build",
        "spec/setup.ts",
        "e2e",
        "__mocks__",
        "tsup.config.ts",
        "vitest.config.mts",
        "vitest.dist.config.mts",
        "vitest.e2e.config.mts",
        "vitest.live.config.mts"
    ],
    "exclude": ["e2e/artifacts"]
}
